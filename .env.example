# ============================================================================
# CodeForge AI — server-side environment configuration
# ============================================================================
#
#   cp .env.example .env      then fill in ONE provider's key and restart.
#
# SECURITY
#   - This file contains PLACEHOLDERS ONLY. Never commit a real key.
#   - .env is git-ignored. Keep it that way.
#   - These variables are read ONLY by server/ (Node). They are never bundled
#     into the browser build. Vite only exposes variables prefixed VITE_, and
#     none of the secrets below use that prefix — that is deliberate.
#   - NEVER rename these to VITE_* . That would ship your key to every visitor.
#   - In production, prefer your platform's secret manager over a .env file.
# ============================================================================

# Preferred provider: gemini | groq | openrouter | openai | anthropic
# If unset, Gemini is preferred. This is the HEAD of the fallback chain,
# NOT a hard pin: on transient failure (429/5xx/timeout) the server
# automatically fails over along the chain:
#   Gemini -> Groq -> OpenRouter Free -> (any other configured provider)
AI_PROVIDER=gemini

# ---------------------------------------------------------------------------
# OpenAI  (also works for Azure OpenAI and any OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=8192
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ---------------------------------------------------------------------------
# Google Gemini
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOKENS=8192
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port for the AI backend. Vite proxies /api to this port in development.
PORT=8787

# Upstream request timeout in milliseconds.
AI_TIMEOUT_MS=120000

# Simple per-IP rate limit. Set to 0 to disable.
RATE_LIMIT_PER_MINUTE=30

# Restrict browser origins in production, e.g. https://app.example.com
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Groq (fallback tier 2 — OpenAI-compatible wire format)
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk-your-groq-key-here
# Groq's currently recommended coding-capable model; override if needed.
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# OpenRouter Free (fallback tier 3 — used only when the others are down)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
# A free routed model (":free" suffix). Override to pin another free model.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Failover tuning (all optional, bounded by default)
# ---------------------------------------------------------------------------
# In-function retries per provider for transient 5xx (default 2)
# UPSTREAM_MAX_RETRIES=2
# Backoff base / total budget per provider attempt (defaults 800 / 40000 ms)
# UPSTREAM_RETRY_BASE_MS=800
# UPSTREAM_RETRY_BUDGET_MS=40000
# Wall-clock budget for the whole provider chain (default 50000 ms; the
# Vercel function limit is 60s)
# PROVIDER_CHAIN_BUDGET_MS=50000

# ---------------------------------------------------------------------------
# Image generation (Image mode) — provider registry, swap without UI changes
# ---------------------------------------------------------------------------
# Preferred image adapter: gemini (default when GEMINI_API_KEY is set) | openai
# IMAGE_PROVIDER=gemini
# IMAGE_MODEL=gemini-2.5-flash-image
# (OpenAI Images adapter uses OPENAI_API_KEY above when configured.)

# ---------------------------------------------------------------------------
# Video generation (Video mode) — HONESTLY disabled until explicitly enabled
# ---------------------------------------------------------------------------
# Video stays "Video provider not configured" until you opt in:
# VIDEO_PROVIDER=veo
# VEO_MODEL=veo-3.0-generate-001
# (VEO_API_KEY or GEMINI_API_KEY supplies the credential.)
